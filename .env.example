# LLM provider: "gemini" or "mock" (mock works without an API key)
LLM_PROVIDER=mock

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Primary model, then comma-separated fallbacks. Each model has its own free quota
# (check "Rate limits" in AI Studio). gemini-2.5-* are no longer available to new keys.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite,gemini-3.6-flash

# Server-wide queue for AI requests
LLM_MAX_CONCURRENT=4
LLM_RPM=15
LLM_QUEUE_WAIT_MS=45000

# Pool of verified tasks (SQLite, default apps/api/data/tasks.db)
TASK_DB_PATH=
# Share of each session served from the pool (0 = always generate, 1 = pool first)
POOL_REUSE_RATIO=0.5

PORT=8787
