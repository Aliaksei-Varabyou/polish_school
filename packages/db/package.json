{
  "name": "@portal/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "supabase start -x realtime,storage-api,imgproxy,studio,edge-runtime,logflare,vector,supavisor,postgres-meta",
    "stop": "supabase stop",
    "status": "supabase status",
    "reset": "supabase db reset",
    "types": "supabase gen types typescript --local > src/database.types.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@portal/core": "*",
    "@portal/task-pool": "*",
    "@supabase/supabase-js": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
